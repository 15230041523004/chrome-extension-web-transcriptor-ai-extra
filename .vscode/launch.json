{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Extension in Chrome",
      "type": "pwa-chrome",
      "request": "attach",
      "port": 9333,
      "urlFilter": "chrome-extension://*/sidepanel.html",
      "targetSelection": "automatic",
      "disableNetworkCache": false,
      "restart": true,
      "timeout": 120000,
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "start chrome with extension",
      "postDebugTask": "stop chrome debug",
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Launch Extension in Chrome (watch)",
      "type": "pwa-chrome",
      "request": "attach",
      "port": 9333,
      "urlFilter": "chrome-extension://*/sidepanel.html",
      "targetSelection": "automatic",
      "disableNetworkCache": false,
      "restart": true,
      "timeout": 120000,
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "start chrome with extension (no build)",
      "postDebugTask": "stop chrome debug",
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Launch Extension + YouTube",
      "type": "pwa-chrome",
      "request": "attach",
      "port": 9333,
      "urlFilter": "chrome-extension://*/sidepanel.html",
      "targetSelection": "automatic",
      "disableNetworkCache": false,
      "restart": true,
      "timeout": 120000,
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "start chrome with extension (youtube)",
      "postDebugTask": "stop chrome debug",
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**",
        "**/www.youtube.com/**",
        "**/www.google.com/**"
      ]
    }
  ]
}
